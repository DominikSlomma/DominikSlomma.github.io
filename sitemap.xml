---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | where_exp:'page','page.sitemap != false' %}
  {% assign posts = site.posts | where_exp:'post','post.sitemap != false' %}
  {% for page in pages %}
    {% if page.url %}
      <url>
        <loc>{{ site.url }}{{ site.baseurl }}{{ page.url | replace:'index.html','' }}</loc>
        <lastmod>{{ page.last_modified_at | default: page.date | default: site.time | date_to_xmlschema }}</lastmod>
      </url>
    {% endif %}
  {% endfor %}
  {% for post in posts %}
    <url>
      <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
      <lastmod>{{ post.last_modified_at | default: post.date | default: site.time | date_to_xmlschema }}</lastmod>
    </url>
  {% endfor %}
</urlset>
